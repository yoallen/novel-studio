{
  "name": "novel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first novel development and writing studio",
  "author": "Yolanda Allen",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:server": "tsx src/server/dev.ts",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "start": "vite build && node --import tsx src/server/dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.11.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
